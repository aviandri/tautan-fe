{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/heavy"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2200, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 150, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }],
        "server-response-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 122880 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    }
  }
}

# ---- Build time (inlined into the client bundle; rebuild to change) ----
# Public API origin the browser calls (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public site origin, used for share links, QR codes and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Host shown in the UI ("tautan.id/alice"). Defaults to tautan.id.
NEXT_PUBLIC_SITE_HOST=localhost:3000
# 1 = in-memory mock API (no backend needed). Must be 0 or unset in production.
NEXT_PUBLIC_API_MOCK=1

# ---- Runtime (server only) ----
# Shared with the API's REVALIDATE_SECRET; enables POST /api/revalidate (503 while unset).
# REVALIDATE_SECRET=
# Optional private URL for server-side page reads, e.g. http://api:8080 in docker-compose.
# API_INTERNAL_URL=
